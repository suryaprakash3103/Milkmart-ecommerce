{
  "name": "milkmart-e-commerce",
  "version": "1.0.0",
  "description": "MilkMart - Pure Farm Fresh Milk & Dairy E-Commerce",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "vite --port 3000 --open",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "mongoose": "^9.13.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.3"
  }
}
